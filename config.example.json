{
  "$schema": "./docs/config.schema.json",
  "configVersion": 1,
  "discord": {
    "token": "DICORD_TOKEN",
    "embeds": {
      "colors": {
        "Pink": "#F5C2E7",
        "Red": "#ED4245",
        "Green": "#57F287",
        "Yellow": "#FFD700"
